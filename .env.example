# Copy this file to .env and fill in real values.
# NEVER commit .env. This example file must only ever contain placeholders.

# --- Anthropic: the API key for job analysis ---
ANTHROPIC_API_KEY=

# --- Telegram: from @BotFather and @userinfobot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_ID=

# --- Dashboard login sessions (generate a long random value) ---
SESSION_SECRET=

# --- Backups: public key from age-keygen (set up in Phase 3) ---
BACKUP_PUBLIC_KEY=

# --- App settings ---
DATABASE_PATH=var/joborbit.db
BASE_URL=http://localhost:8000
CONTACT_EMAIL=
ENV=development
DRY_RUN=true
